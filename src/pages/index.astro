---
import MainLayout from '../layouts/MainLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Timeline from '../components/Timeline.astro';
import Qualifications from '../components/Qualifications.astro';
import { education, experience, certifications } from '../content/profile';
---

<MainLayout title="Home">
  <!-- Hero Section -->
  <section class="hero">
    <div class="glow-dot glow-dot--blue hero-glow-1"></div>
    <div class="glow-dot glow-dot--purple hero-glow-2"></div>
    <div class="hero-glyphs" aria-hidden="true">
      <span class="hero-glyph hero-glyph--1">{'{ }'}</span>
      <span class="hero-glyph hero-glyph--2">&lt;/&gt;</span>
      <span class="hero-glyph hero-glyph--3">01</span>
      <span class="hero-glyph hero-glyph--4">λ</span>
      <span class="hero-glyph hero-glyph--5">::</span>
    </div>
    <div class="container">
      <div class="hero-content">
        <p class="hero-terminal">
          <span class="term-user">jacky@portfolio</span>
          <span class="term-sep">:</span>
          <span class="term-path">~</span>
          <span class="term-prompt">$</span>
          <span class="term-cmd">whoami</span>
          <span class="term-caret"></span>
        </p>
        <p class="hero-greeting">Hello, I'm</p>
        <div class="hero-name-wrap">
          <h1 class="hero-name">Jacky Wong</h1>
          <span class="hero-name-ghost hero-name-ghost--cyan" aria-hidden="true">Jacky Wong</span>
          <span class="hero-name-ghost hero-name-ghost--pink" aria-hidden="true">Jacky Wong</span>
        </div>

        <p class="hero-description">
          I build things for real impacts. Welcome to my professional portfolio.
        </p>
        <SocialLinks />
        <nav class="quick-links">
          <a href="#experience" class="quick-link quick-link--purple shine">
            <span class="quick-link-label">Experience</span>
            <span class="quick-link-arrow">&darr;</span>
          </a>
          <a href="#education" class="quick-link quick-link--blue shine">
            <span class="quick-link-label">Education</span>
            <span class="quick-link-arrow">&darr;</span>
          </a>
          <a href="#qualifications" class="quick-link quick-link--emerald shine">
            <span class="quick-link-label">Certifications</span>
            <span class="quick-link-arrow">&darr;</span>
          </a>
        </nav>
      </div>
    </div>
  </section>

  <div class="container"><hr class="gradient-divider" /></div>

  <!-- Experience -->
  <section class="section reveal" id="experience">
    <div class="container">
      <h2 class="section-title">Professional Experiences</h2>
      <Timeline entries={experience} />
    </div>
  </section>

  <div class="container"><hr class="gradient-divider" /></div>

  <!-- Education -->
  <section class="section reveal" id="education">
    <div class="container">
      <h2 class="section-title">Education</h2>
      <Timeline entries={education} />
    </div>
  </section>

  <div class="container"><hr class="gradient-divider" /></div>

  <!-- Qualifications / Certifications -->
  <section class="section reveal" id="qualifications">
    <div class="container">
      <h2 class="section-title">Certifications</h2>
      <Qualifications qualifications={certifications} />
    </div>
  </section>

  <div class="container"><hr class="gradient-divider" /></div>


</MainLayout>

<style>
  /* ── Hero ─────────────────────────────────────────── */
  .hero {
    padding: var(--space-3xl) 0;
    min-height: 50vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .hero-glow-1 {
    top: -100px;
    right: -50px;
    width: 400px;
    height: 400px;
    opacity: 0.15;
  }

  .hero-glow-2 {
    bottom: -80px;
    left: 30%;
    width: 350px;
    height: 350px;
    opacity: 0.1;
  }

  .hero-content {
    max-width: 680px;
    position: relative;
    z-index: 1;
  }

  .hero-glyphs {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-glyph {
    position: absolute;
    font-family: var(--font-mono);
    color: var(--color-accent);
    opacity: 0.28;
    text-shadow: 0 0 12px rgba(56, 189, 248, 0.45);
    animation: float-orbit 9s ease-in-out infinite;
  }

  .hero-glyph--1 { top: 12%; right: 8%; font-size: 1.6rem; }
  .hero-glyph--2 { top: 38%; right: 16%; font-size: 1.25rem; animation-duration: 11s; color: var(--color-purple); }
  .hero-glyph--3 { bottom: 22%; right: 10%; font-size: 1.1rem; animation-duration: 8s; color: var(--color-pink); }
  .hero-glyph--4 { top: 18%; right: 28%; font-size: 1.4rem; animation-duration: 12s; }
  .hero-glyph--5 { bottom: 30%; right: 26%; font-size: 1.3rem; animation-duration: 10s; color: var(--color-emerald); }

  .hero-terminal {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-text-muted);
    background: rgba(8, 14, 26, 0.72);
    border: 1px solid rgba(56, 189, 248, 0.22);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    margin-bottom: var(--space-lg);
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.08);
    backdrop-filter: blur(10px);
  }

  .term-user { color: var(--color-emerald); }
  .term-sep { color: var(--color-text-muted); }
  .term-path { color: var(--color-purple); }
  .term-prompt { color: var(--color-accent); }
  .term-cmd { color: var(--color-text-heading); }

  .term-caret {
    width: 7px;
    height: 1rem;
    background: var(--color-accent);
    box-shadow: 0 0 10px var(--color-accent);
    animation: blink-caret 1s step-end infinite;
  }

  .hero-greeting {
    font-size: 1.1rem;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: var(--space-sm);
    letter-spacing: 0.04em;
    text-shadow: 0 0 18px rgba(56, 189, 248, 0.35);
  }

  .hero-name-wrap {
    position: relative;
    display: inline-block;
    margin-bottom: var(--space-md);
  }

  .hero-name {
    position: relative;
    z-index: 1;
    font-size: 3.6rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin: 0;
    background: linear-gradient(
      120deg,
      #f8fafc 0%,
      #38bdf8 28%,
      #a78bfa 55%,
      #f472b6 78%,
      #f8fafc 100%
    );
    background-size: 220% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmer-shift 7s linear infinite;
  }

  .hero-name-ghost {
    position: absolute;
    inset: 0;
    font-family: var(--font-display);
    font-size: 3.6rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    pointer-events: none;
    animation: glitch-slice 4.2s linear infinite;
  }

  .hero-name-ghost--cyan {
    color: #22d3ee;
    mix-blend-mode: screen;
  }

  .hero-name-ghost--pink {
    color: #f472b6;
    mix-blend-mode: screen;
    animation-delay: 0.15s;
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    font-weight: 500;
  }

  .dot {
    color: var(--color-accent);
    font-weight: 700;
  }

  .hero-description {
    font-size: 1.05rem;
    color: var(--color-text);
    margin-bottom: var(--space-xl);
    max-width: 720px;
  }

  /* ── Quick-link buttons (colorful) ───────────────── */
  .quick-links {
    display: flex;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    flex-wrap: wrap;
  }

  .quick-link {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-size: 1rem;
    font-weight: 600;
    padding: var(--space-md) var(--space-xl);
    border-radius: var(--radius-lg);
    border: 2px solid;
    text-decoration: none;
    transition: all var(--transition-normal);
  }

  .quick-link-label {
    flex: 1;
  }

  .quick-link-arrow {
    font-size: 1.1rem;
    transition: transform var(--transition-fast);
  }

  .quick-link:hover .quick-link-arrow {
    transform: translateY(3px);
  }

  .quick-link--blue {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: rgba(56, 189, 248, 0.08);
  }
  .quick-link--blue:hover {
    background: rgba(56, 189, 248, 0.2);
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.25), inset 0 0 20px rgba(56, 189, 248, 0.06);
    color: var(--color-accent-hover);
  }

  .quick-link--purple {
    color: var(--color-purple);
    border-color: var(--color-purple);
    background: rgba(167, 139, 250, 0.08);
  }
  .quick-link--purple:hover {
    background: rgba(167, 139, 250, 0.2);
    box-shadow: 0 0 20px rgba(167, 139, 250, 0.25), inset 0 0 20px rgba(167, 139, 250, 0.06);
    color: #c4b5fd;
  }

  .quick-link--emerald {
    color: var(--color-emerald);
    border-color: var(--color-emerald);
    background: rgba(52, 211, 153, 0.08);
  }
  .quick-link--emerald:hover {
    background: rgba(52, 211, 153, 0.2);
    box-shadow: 0 0 20px rgba(52, 211, 153, 0.25), inset 0 0 20px rgba(52, 211, 153, 0.06);
    color: #6ee7b7;
  }

  /* ── Responsive ──────────────────────────────────── */
  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: var(--space-2xl) 0;
    }

    .hero-name,
    .hero-name-ghost {
      font-size: 2.5rem;
    }

    .hero-glyphs {
      display: none;
    }

    .quick-links {
      gap: var(--space-sm);
      flex-direction: column;
    }

    .quick-link {
      padding: var(--space-sm) var(--space-lg);
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-name,
    .hero-glyph,
    .hero-name-ghost,
    .term-caret {
      animation: none;
    }

    .hero-name-ghost {
      display: none;
    }
  }
</style>
