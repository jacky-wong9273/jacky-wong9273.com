---
import MainLayout from '../layouts/MainLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Timeline from '../components/Timeline.astro';
import Qualifications from '../components/Qualifications.astro';
import Skills from '../components/Skills.astro';
import { education, experience, certifications } from '../content/profile';
---

<MainLayout title="Home">
  <!-- Hero Section -->
  <section class="hero">
    <div class="glow-dot glow-dot--blue hero-glow-1"></div>
    <div class="glow-dot glow-dot--purple hero-glow-2"></div>
    <div class="container">
      <div class="hero-content">
        <p class="hero-greeting">Hello, I'm</p>
        <h1 class="hero-name">Jacky Wong</h1>

        <p class="hero-description">
          I build things for real impacts. Welcome to my professional portfolio.
        </p>
        <SocialLinks />
        <nav class="quick-links">
          <a href="#experience" class="quick-link quick-link--purple">
            <span class="quick-link-label">Experience</span>
            <span class="quick-link-arrow">&darr;</span>
          </a>
          <a href="#education" class="quick-link quick-link--blue">
            <span class="quick-link-label">Education</span>
            <span class="quick-link-arrow">&darr;</span>
          </a>
          <a href="#qualifications" class="quick-link quick-link--emerald">
            <span class="quick-link-label">Certifications</span>
            <span class="quick-link-arrow">&darr;</span>
          </a>
        </nav>
      </div>
    </div>
  </section>

  <div class="container"><hr class="gradient-divider" /></div>

  <!-- Experience -->
  <section class="section" id="experience">
    <div class="container">
      <h2 class="section-title">Professional Experiences</h2>
      <Timeline entries={experience} />
    </div>
  </section>

  <div class="container"><hr class="gradient-divider" /></div>

  <!-- Education -->
  <section class="section" id="education">
    <div class="container">
      <h2 class="section-title">Education</h2>
      <Timeline entries={education} />
    </div>
  </section>

  <div class="container"><hr class="gradient-divider" /></div>

  <!-- Qualifications / Certifications -->
  <section class="section" id="qualifications">
    <div class="container">
      <h2 class="section-title">Certifications</h2>
      <Qualifications qualifications={certifications} />
    </div>
  </section>

  <div class="container"><hr class="gradient-divider" /></div>


</MainLayout>

<style>
  /* ── Hero ─────────────────────────────────────────── */
  .hero {
    padding: var(--space-3xl) 0;
    min-height: 50vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .hero-glow-1 {
    top: -100px;
    right: -50px;
    width: 400px;
    height: 400px;
    opacity: 0.15;
  }

  .hero-glow-2 {
    bottom: -80px;
    left: 30%;
    width: 350px;
    height: 350px;
    opacity: 0.1;
  }

  .hero-content {
    max-width: 640px;
  }

  .hero-greeting {
    font-size: 1.1rem;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: var(--space-sm);
  }

  .hero-name {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-md);
    background: linear-gradient(135deg, var(--color-text-heading) 0%, var(--color-accent) 40%, var(--color-purple) 70%, var(--color-pink) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    font-weight: 500;
  }

  .dot {
    color: var(--color-accent);
    font-weight: 700;
  }

  .hero-description {
    font-size: 1.05rem;
    color: var(--color-text);
    margin-bottom: var(--space-xl);
    max-width: 720px;
  }

  /* ── Quick-link buttons (colorful) ───────────────── */
  .quick-links {
    display: flex;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    flex-wrap: wrap;
  }

  .quick-link {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-size: 1rem;
    font-weight: 600;
    padding: var(--space-md) var(--space-xl);
    border-radius: var(--radius-lg);
    border: 2px solid;
    text-decoration: none;
    transition: all var(--transition-normal);
  }

  .quick-link-label {
    flex: 1;
  }

  .quick-link-arrow {
    font-size: 1.1rem;
    transition: transform var(--transition-fast);
  }

  .quick-link:hover .quick-link-arrow {
    transform: translateY(3px);
  }

  .quick-link--blue {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: rgba(56, 189, 248, 0.08);
  }
  .quick-link--blue:hover {
    background: rgba(56, 189, 248, 0.2);
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.25), inset 0 0 20px rgba(56, 189, 248, 0.06);
    color: var(--color-accent-hover);
  }

  .quick-link--purple {
    color: var(--color-purple);
    border-color: var(--color-purple);
    background: rgba(167, 139, 250, 0.08);
  }
  .quick-link--purple:hover {
    background: rgba(167, 139, 250, 0.2);
    box-shadow: 0 0 20px rgba(167, 139, 250, 0.25), inset 0 0 20px rgba(167, 139, 250, 0.06);
    color: #c4b5fd;
  }

  .quick-link--emerald {
    color: var(--color-emerald);
    border-color: var(--color-emerald);
    background: rgba(52, 211, 153, 0.08);
  }
  .quick-link--emerald:hover {
    background: rgba(52, 211, 153, 0.2);
    box-shadow: 0 0 20px rgba(52, 211, 153, 0.25), inset 0 0 20px rgba(52, 211, 153, 0.06);
    color: #6ee7b7;
  }

  /* ── Responsive ──────────────────────────────────── */
  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: var(--space-2xl) 0;
    }

    .hero-name {
      font-size: 2.5rem;
    }

    .quick-links {
      gap: var(--space-sm);
      flex-direction: column;
    }

    .quick-link {
      padding: var(--space-sm) var(--space-lg);
      font-size: 0.9rem;
    }
  }
</style>
