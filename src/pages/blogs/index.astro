---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allBlogs = (await getCollection('blogs', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Build a JSON-safe search index for client-side search
const searchIndex = allBlogs.map(post => ({
  id: post.id.replace(/\.mdx?$/, ''),
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags,
  date: post.data.date.toISOString(),
  dateFormatted: post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
}));
---

<MainLayout title="Blog" description="Personal blog posts by Jacky Wong.">
  <section class="section">
    <div class="container">
      <h1 class="page-title gradient-text">Blog</h1>
      <p class="page-description">
        Thoughts, tutorials, and things I've learned along the way.
      </p>

      <!-- Search bar -->
      <div class="search-wrapper">
        <div class="search-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
        </div>
        <input
          type="text"
          id="blog-search"
          class="search-input"
          placeholder="Search posts by title, description, or tag..."
          autocomplete="off"
        />
        <kbd class="search-kbd">Ctrl K</kbd>
      </div>

      <!-- Results count -->
      <p class="results-count" id="results-count">
        {allBlogs.length} post{allBlogs.length !== 1 ? 's' : ''}
      </p>

      {allBlogs.length === 0 && (
        <div class="empty-state">
          <div class="empty-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
              <path d="m15 5 4 4"/>
            </svg>
          </div>
          <p>No blog posts yet. Check back soon!</p>
        </div>
      )}

      <!-- Blog list -->
      <div class="blog-list" id="blog-list">
        {allBlogs.map((post, i) => (
          <a href={`/blogs/${post.id.replace(/\.mdx?$/, '')}`} class="blog-item card" data-index={i}>
            <div class="blog-item-inner">
              <div class="blog-date-col">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <div class="blog-content-col">
                <h2 class="blog-title">{post.data.title}</h2>
                <p class="blog-desc">{post.data.description}</p>
                <div class="blog-tags">
                  {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
              </div>
              <div class="blog-arrow">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/>
                  <path d="m12 5 7 7-7 7"/>
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- No results message (hidden by default) -->
      <div class="no-results" id="no-results" style="display: none;">
        <p>No posts match your search. Try a different keyword.</p>
      </div>
    </div>
  </section>

  <!-- Pass search index to client -->
  <script define:vars={{ searchIndex }}>
    window.__BLOG_SEARCH_INDEX__ = searchIndex;
  </script>
</MainLayout>

<script>
  const searchInput = document.getElementById('blog-search') as HTMLInputElement;
  const blogList = document.getElementById('blog-list');
  const resultsCount = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');
  const items = blogList?.querySelectorAll('.blog-item') as NodeListOf<HTMLElement>;
  const index = (window as any).__BLOG_SEARCH_INDEX__ as Array<{
    id: string;
    title: string;
    description: string;
    tags: string[];
    date: string;
    dateFormatted: string;
  }>;

  function performSearch(query: string) {
    const q = query.toLowerCase().trim();
    let visible = 0;

    items.forEach((item, i) => {
      const entry = index[i];
      if (!q) {
        item.style.display = '';
        visible++;
        return;
      }

      const haystack = [
        entry.title,
        entry.description,
        ...entry.tags,
        entry.dateFormatted,
      ].join(' ').toLowerCase();

      if (haystack.includes(q)) {
        item.style.display = '';
        visible++;
      } else {
        item.style.display = 'none';
      }
    });

    if (resultsCount) {
      resultsCount.textContent = `${visible} post${visible !== 1 ? 's' : ''}${q ? ` matching "${query}"` : ''}`;
    }

    if (noResults) {
      noResults.style.display = visible === 0 && q ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', () => {
    performSearch(searchInput.value);
  });

  // Ctrl+K to focus search
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      searchInput?.focus();
    }
    if (e.key === 'Escape' && document.activeElement === searchInput) {
      searchInput.value = '';
      performSearch('');
      searchInput.blur();
    }
  });
</script>

<style>
  .page-title {
    font-size: 2.5rem;
    margin-bottom: var(--space-md);
    display: inline-block;
  }

  .page-description {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin-bottom: var(--space-xl);
  }

  /* Search */
  .search-wrapper {
    position: relative;
    margin-bottom: var(--space-md);
    max-width: 560px;
  }

  .search-icon {
    position: absolute;
    left: var(--space-md);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 0.75rem var(--space-xl) 0.75rem 2.75rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    font-size: 0.9rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .search-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.1), 0 0 20px rgba(56, 189, 248, 0.08);
  }

  .search-kbd {
    position: absolute;
    right: var(--space-md);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.125rem 0.375rem;
    pointer-events: none;
    opacity: 0.6;
  }

  .results-count {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }

  /* Blog list */
  .blog-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .blog-item {
    text-decoration: none;
    color: inherit;
    padding: var(--space-lg) var(--space-xl);
  }

  .blog-item:hover {
    border-color: var(--color-accent);
  }

  .blog-item-inner {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xl);
  }

  .blog-date-col {
    flex-shrink: 0;
    width: 100px;
  }

  .blog-date-col time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .blog-content-col {
    flex: 1;
    min-width: 0;
  }

  .blog-title {
    font-size: 1.2rem;
    margin-bottom: 0.375rem;
    transition: color var(--transition-fast);
  }

  .blog-item:hover .blog-title {
    color: var(--color-accent);
  }

  .blog-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .blog-arrow {
    flex-shrink: 0;
    color: var(--color-border);
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: flex;
    align-items: center;
    padding-top: 0.25rem;
  }

  .blog-item:hover .blog-arrow {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  .no-results {
    text-align: center;
    padding: var(--space-2xl) 0;
    color: var(--color-text-muted);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-3xl) 0;
    color: var(--color-text-muted);
  }

  .empty-icon {
    margin-bottom: var(--space-md);
    color: var(--color-border);
  }

  @media (max-width: 768px) {
    .blog-item-inner {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .blog-date-col {
      width: auto;
    }

    .blog-arrow {
      display: none;
    }

    .search-kbd {
      display: none;
    }
  }
</style>
