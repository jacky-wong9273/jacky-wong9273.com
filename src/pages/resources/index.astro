---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allResources = (await getCollection('resources', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [
  { key: 'all', label: 'All' },
  { key: 'ib-cs-sl', label: 'IB CS SL' },
  { key: 'ib-cs-hl', label: 'IB CS HL' },
  { key: 'general', label: 'General' },
] as const;

// Group resources by category for rendering
const resourcesByCategory = {
  'ib-cs-sl': allResources.filter(r => r.data.category === 'ib-cs-sl'),
  'ib-cs-hl': allResources.filter(r => r.data.category === 'ib-cs-hl'),
  'general': allResources.filter(r => r.data.category === 'general'),
};
---

<MainLayout title="Resources" description="IB Computer Science SL & HL resources by Jacky Wong.">
  <section class="section">
    <div class="container">
      <h1 class="page-title">Resources</h1>
      <p class="page-description">
        Study materials and resources for my IB Computer Science SL &amp; HL students.
        Browse by category or explore everything below.
      </p>

      <!-- Category filter (client-side) -->
      <div class="category-filters" id="category-filters">
        {categories.map(cat => (
          <button
            class:list={['filter-btn', { active: cat.key === 'all' }]}
            data-category={cat.key}
          >
            {cat.label}
            {cat.key !== 'all' && (
              <span class="count">
                {cat.key === 'ib-cs-sl' ? resourcesByCategory['ib-cs-sl'].length :
                 cat.key === 'ib-cs-hl' ? resourcesByCategory['ib-cs-hl'].length :
                 resourcesByCategory['general'].length}
              </span>
            )}
          </button>
        ))}
      </div>

      {allResources.length === 0 && (
        <div class="empty-state">
          <div class="empty-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
          </div>
          <p>Resources coming soon. Stay tuned!</p>
        </div>
      )}

      <div class="resources-list" id="resources-list">
        {allResources.map(resource => (
          <a href={`/resources/${resource.id.replace(/\.mdx?$/, '')}`} class="resource-item card" data-category={resource.data.category}>
            <div class="resource-category-badge">
              {resource.data.category === 'ib-cs-sl' ? 'SL' :
               resource.data.category === 'ib-cs-hl' ? 'HL' : 'GEN'}
            </div>
            <div class="resource-body">
              <h2 class="resource-title">{resource.data.title}</h2>
              <p class="resource-desc">{resource.data.description}</p>
              <div class="resource-footer">
                <time datetime={resource.data.date.toISOString()}>
                  {resource.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <div class="resource-tags">
                  {resource.data.tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .page-title {
    font-size: 2.5rem;
    margin-bottom: var(--space-md);
  }

  .page-description {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin-bottom: var(--space-xl);
  }

  .category-filters {
    display: flex;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xl);
    flex-wrap: wrap;
  }

  .filter-btn {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    padding: var(--space-sm) var(--space-md);
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-sans);
  }

  .filter-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .filter-btn.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
  }

  .filter-btn .count {
    background: rgba(255, 255, 255, 0.15);
    padding: 0 0.375rem;
    border-radius: 9999px;
    font-size: 0.75rem;
  }

  .filter-btn.active .count {
    background: rgba(0, 0, 0, 0.2);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-3xl) 0;
    color: var(--color-text-muted);
  }

  .empty-icon {
    margin-bottom: var(--space-md);
    color: var(--color-border);
  }

  .resources-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .resource-item {
    display: flex;
    gap: var(--space-lg);
    text-decoration: none;
    color: inherit;
    align-items: flex-start;
  }

  .resource-item:hover {
    border-color: var(--color-accent);
  }

  .resource-item[data-hidden="true"] {
    display: none;
  }

  .resource-category-badge {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-tag-bg);
    color: var(--color-accent);
    border-radius: var(--radius-md);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .resource-body {
    flex: 1;
    min-width: 0;
  }

  .resource-title {
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .resource-desc {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .resource-footer {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .resource-footer time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .resource-tags {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .resource-item {
      flex-direction: column;
      gap: var(--space-sm);
    }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const items = document.querySelectorAll('.resource-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active button
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const category = btn.getAttribute('data-category');

      items.forEach(item => {
        if (category === 'all' || item.getAttribute('data-category') === category) {
          item.removeAttribute('data-hidden');
          (item as HTMLElement).style.display = '';
        } else {
          item.setAttribute('data-hidden', 'true');
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
