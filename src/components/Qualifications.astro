---
export interface Qualification {
  title: string;
  institution: string;
  year: string;
  description?: string;
}

interface Props {
  qualifications: Qualification[];
}

const { qualifications } = Astro.props;
---

<div class="qualifications-grid">
  {qualifications.map(qual => (
    <div class="qualification-card card">
      <div class="qual-header">
        <div class="qual-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
            <path d="M6 12v5c3 3 9 3 12 0v-5" />
          </svg>
        </div>
        <span class="qual-year">{qual.year}</span>
      </div>
      <h3 class="qual-title">{qual.title}</h3>
      <p class="qual-institution">{qual.institution}</p>
      {qual.description && <p class="qual-desc">{qual.description}</p>}
    </div>
  ))}
</div>

<style>
  .qualifications-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .qualification-card {
    display: flex;
    flex-direction: column;
    border-left: 3px solid var(--color-accent);
    transition: border-color var(--transition-normal), transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .qualification-card:nth-child(2) {
    border-left-color: var(--color-purple);
  }

  .qualification-card:nth-child(3) {
    border-left-color: var(--color-emerald);
  }

  .qualification-card:hover {
    box-shadow: var(--shadow-glow);
  }

  .qualification-card:nth-child(2):hover {
    box-shadow: var(--shadow-glow-purple);
  }

  .qual-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
  }

  .qual-icon {
    color: var(--color-accent);
    display: flex;
    align-items: center;
  }

  .qual-year {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-tag-bg);
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .qual-title {
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .qual-institution {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-sm);
  }

  .qual-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 768px) {
    .qualifications-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
