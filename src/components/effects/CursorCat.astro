---
import CatContextMenu from './CatContextMenu.astro';
---

<div class="cursor-cat" id="cursor-cat" aria-hidden="true" data-pose="sit" data-expr="neutral" data-lure="toy">
  <div class="cursor-cat-trail" id="cursor-cat-trail"></div>

  <div class="cursor-cat-wrap">
    <div class="cat-zzz">
      <span>z</span>
      <span>z</span>
      <span>Z</span>
    </div>

    <svg class="cursor-cat-svg" viewBox="0 0 260 170" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="maat-ivory" x1="70" y1="60" x2="200" y2="160" gradientUnits="userSpaceOnUse">
          <stop stop-color="#fff6e4" />
          <stop offset="0.42" stop-color="#ead4ae" />
          <stop offset="1" stop-color="#c9a36f" />
        </linearGradient>
        <linearGradient id="maat-ivory-sit" x1="80" y1="70" x2="190" y2="160" gradientUnits="userSpaceOnUse">
          <stop stop-color="#fff8ea" />
          <stop offset="0.5" stop-color="#e6d0a6" />
          <stop offset="1" stop-color="#c4a072" />
        </linearGradient>
        <linearGradient id="maat-seal" x1="80" y1="16" x2="160" y2="90" gradientUnits="userSpaceOnUse">
          <stop stop-color="#6b4328" />
          <stop offset="0.55" stop-color="#3d2817" />
          <stop offset="1" stop-color="#24150c" />
        </linearGradient>
        <linearGradient id="maat-mask" x1="100" y1="30" x2="150" y2="80" gradientUnits="userSpaceOnUse">
          <stop stop-color="#5a3820" />
          <stop offset="1" stop-color="#2c1a10" />
        </linearGradient>
        <linearGradient id="maat-point-leg" x1="0" y1="0" x2="0" y2="1">
          <stop stop-color="#c9a36f" />
          <stop offset="0.35" stop-color="#8a5a34" />
          <stop offset="1" stop-color="#2a160c" />
        </linearGradient>
        <linearGradient id="maat-eye" x1="0" y1="0" x2="0" y2="1">
          <stop stop-color="#8fd4f5" />
          <stop offset="0.45" stop-color="#2f7fbf" />
          <stop offset="1" stop-color="#16324a" />
        </linearGradient>
        <linearGradient id="maat-tail" x1="20" y1="20" x2="90" y2="120" gradientUnits="userSpaceOnUse">
          <stop stop-color="#2a160c" />
          <stop offset="0.55" stop-color="#4a2d1a" />
          <stop offset="1" stop-color="#8a5a34" />
        </linearGradient>
        <filter id="maat-soft" x="-18%" y="-18%" width="136%" height="136%">
          <feDropShadow dx="0" dy="3" stdDeviation="2.4" flood-color="#1a1008" flood-opacity="0.28" />
        </filter>
        <filter id="maat-fur" x="-8%" y="-8%" width="116%" height="116%">
          <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="4" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="1.1" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>

      <!-- Side profile: walk, hunt, pounce, pin -->
      <g class="cat-pose cat-pose--side">
        <ellipse class="cat-ground" cx="138" cy="161" rx="74" ry="6.5" fill="#140c08" opacity="0.3" />

        <g class="cat-tail">
          <path d="M90 116 C58 110 34 86 32 56 C30 36 12 30 16 14" stroke="url(#maat-tail)" stroke-width="11" stroke-linecap="round" />
          <path d="M90 116 C58 110 34 86 32 56 C30 36 12 30 16 14" stroke="#8a5a34" stroke-width="4.5" stroke-linecap="round" opacity="0.35" />
        </g>

        <g class="cat-leg cat-leg--hind-far">
          <path d="M126 120 C120 134 116 146 118 156" stroke="#5a3a22" stroke-width="8" stroke-linecap="round" />
          <ellipse cx="116" cy="157" rx="9" ry="4.4" fill="#24150c" />
        </g>

        <g class="cat-body" filter="url(#maat-soft)">
          <path
            d="M92 122 C86 96 104 70 138 68 C168 66 186 78 194 96 C200 110 196 124 184 132 C168 144 142 148 118 144 C100 140 94 132 92 122 Z"
            fill="url(#maat-ivory)"
            filter="url(#maat-fur)"
          />
          <path d="M116 128 C128 138 160 138 176 122 C170 134 148 142 126 140 C116 138 112 132 116 128 Z" fill="#fff6e4" opacity="0.62" />
          <ellipse cx="172" cy="104" rx="22" ry="18" fill="#6b4328" opacity="0.16" />
          <path d="M104 94 C124 80 154 78 180 92" stroke="#f3e2c2" stroke-width="2" opacity="0.35" />
        </g>

        <g class="cat-leg cat-leg--hind-near">
          <path d="M150 122 C148 138 154 148 160 157" stroke="url(#maat-point-leg)" stroke-width="9" stroke-linecap="round" />
          <ellipse cx="162" cy="158" rx="10" ry="4.6" fill="#24150c" />
        </g>
        <g class="cat-leg cat-leg--fore-far">
          <path d="M168 116 C174 132 176 144 172 156" stroke="#5a3a22" stroke-width="7.4" stroke-linecap="round" />
          <ellipse cx="170" cy="157" rx="8.4" ry="4.1" fill="#24150c" />
        </g>
        <g class="cat-leg cat-leg--fore-near">
          <path d="M184 114 C186 132 180 146 176 157" stroke="url(#maat-point-leg)" stroke-width="8.6" stroke-linecap="round" />
          <ellipse cx="174" cy="158" rx="10" ry="4.5" fill="#24150c" />
        </g>

        <g class="cat-head">
          <path d="M176 98 C182 88 190 84 198 88 C190 104 182 110 174 110 Z" fill="url(#maat-ivory)" />
          <path d="M198 60 L206 34 L216 62 Z" fill="#3a2414" />
          <path
            d="M186 94 C188 66 206 50 224 54 C238 58 246 70 244 84 C242 98 228 106 212 104 C196 102 186 100 186 94 Z"
            fill="url(#maat-ivory)"
          />
          <path class="cat-ear cat-ear--near" d="M206 62 L216 26 L230 64 Z" fill="url(#maat-seal)" />
          <path d="M212 60 L218 36 L226 62 Z" fill="#c99290" />
          <path d="M202 58 C210 48 226 48 236 60 C242 68 242 80 236 88 C226 78 212 70 202 70 Z" fill="url(#maat-mask)" opacity="0.94" />
          <ellipse cx="232" cy="88" rx="12" ry="9" fill="#fff3dc" />
          <g class="cat-eye-open">
            <path d="M216 70 C220 65.8 228 65.8 232 71 C228 76 220 76 216 70 Z" fill="#122334" />
            <path d="M218 70 C221 67.4 227 67.4 230 71 C227 73.8 221 73.8 218 70 Z" fill="url(#maat-eye)" />
            <ellipse class="cat-pupil" cx="224" cy="70.5" rx="1.45" ry="3.1" fill="#070b10" />
            <circle cx="225.3" cy="69" r="0.85" fill="#eef8ff" />
          </g>
          <path class="cat-eye-shut" d="M216 71 C222 74.5 230 74.5 232 71" stroke="#3a2414" stroke-width="1.7" stroke-linecap="round" />
          <ellipse cx="238" cy="84" rx="2.3" ry="1.6" fill="#a86a6c" />
          <path class="cat-mouth-shut" d="M238 86 C236 90 232 90.5 229 87.5" stroke="#6d4038" stroke-width="1.1" stroke-linecap="round" />
          <ellipse class="cat-mouth-eat" cx="236" cy="90" rx="4.2" ry="3.1" fill="#6b3034" />
          <path d="M220 90 H198" stroke="#e8d5b8" stroke-width="1" opacity="0.72" />
          <path d="M220 94 H194" stroke="#e8d5b8" stroke-width="0.85" opacity="0.42" />
          <path d="M234 92 H252" stroke="#e8d5b8" stroke-width="0.95" opacity="0.5" />
        </g>
      </g>

      <!-- Sit / loaf / groom / watch -->
      <g class="cat-pose cat-pose--sit">
        <ellipse class="cat-ground" cx="130" cy="161" rx="62" ry="6.5" fill="#140c08" opacity="0.3" />
        <g class="cat-tail">
