        <g class="cat-leg cat-leg--fore-near">
          <path d="M70 128 C54 138 40 148 34 156" stroke="url(#maat-point-leg)" stroke-width="8" stroke-linecap="round" />
          <ellipse cx="32" cy="157" rx="11" ry="4.6" fill="#24150c" />
