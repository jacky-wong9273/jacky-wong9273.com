    <circle cx="12.6" cy="15.8" r="0.55" fill="#f6f0de" />
    <path d="M16 14 C18 17 18 20 16 22" stroke="#a86a32" stroke-width="1" />
    <ellipse cx="8" cy="17" rx="3.2" ry="2.4" fill="#e7b36a" />
