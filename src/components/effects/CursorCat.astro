---
import CatContextMenu from './CatContextMenu.astro';
---

<div class="cursor-cat" id="cursor-cat" aria-hidden="true" data-pose="sit" data-expr="neutral" data-lure="toy">
  <div class="cursor-cat-trail" id="cursor-cat-trail"></div>

  <div class="cursor-cat-wrap">
    <div class="cat-zzz">
      <span>z</span>
      <span>z</span>
      <span>Z</span>
    </div>

    <svg class="cursor-cat-svg" viewBox="0 0 260 180" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="maat-ivory" x1="70" y1="60" x2="200" y2="160" gradientUnits="userSpaceOnUse">
          <stop stop-color="#fff8ec" />
          <stop offset="0.38" stop-color="#edd6b0" />
          <stop offset="1" stop-color="#c9a36f" />
        </linearGradient>
        <linearGradient id="maat-ivory-sit" x1="80" y1="70" x2="190" y2="170" gradientUnits="userSpaceOnUse">
          <stop stop-color="#fff9ee" />
          <stop offset="0.48" stop-color="#e8d2a8" />
          <stop offset="1" stop-color="#c4a072" />
        </linearGradient>
        <linearGradient id="maat-seal" x1="80" y1="8" x2="160" y2="80" gradientUnits="userSpaceOnUse">
          <stop stop-color="#7a4e2e" />
          <stop offset="0.5" stop-color="#3f2818" />
          <stop offset="1" stop-color="#1c1008" />
        </linearGradient>
        <linearGradient id="maat-mask" x1="100" y1="24" x2="150" y2="86" gradientUnits="userSpaceOnUse">
          <stop stop-color="#6a4228" />
          <stop offset="1" stop-color="#2a1a10" />
        </linearGradient>
        <linearGradient id="maat-point-leg" x1="0" y1="0" x2="0" y2="1">
          <stop stop-color="#d2b48a" />
          <stop offset="0.28" stop-color="#8a5a34" />
          <stop offset="1" stop-color="#24150c" />
        </linearGradient>
        <radialGradient id="maat-eye" cx="45%" cy="38%" r="70%">
          <stop stop-color="#d8f4ff" />
          <stop offset="0.22" stop-color="#63c6f0" />
          <stop offset="0.62" stop-color="#1f6fad" />
          <stop offset="1" stop-color="#10243a" />
        </radialGradient>
        <linearGradient id="maat-tail" x1="20" y1="20" x2="90" y2="120" gradientUnits="userSpaceOnUse">
          <stop stop-color="#1c1008" />
          <stop offset="0.5" stop-color="#4a2d1a" />
          <stop offset="1" stop-color="#8a5a34" />
        </linearGradient>
        <filter id="maat-soft" x="-18%" y="-18%" width="136%" height="136%">
          <feDropShadow dx="0" dy="3" stdDeviation="2.2" flood-color="#1a1008" flood-opacity="0.3" />
        </filter>
        <filter id="maat-eye-glow" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur stdDeviation="0.8" result="b" />
          <feMerge>
            <feMergeNode in="b" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <!-- Side profile: walk, hunt, pounce, pin -->
      <g class="cat-pose cat-pose--side">
        <ellipse class="cat-ground" cx="138" cy="161" rx="74" ry="6.5" fill="#140c08" opacity="0.3" />

        <g class="cat-tail">
          <path d="M90 116 C58 110 34 86 32 56 C30 36 12 30 16 14" stroke="url(#maat-tail)" stroke-width="11" stroke-linecap="round" />
          <path d="M90 116 C58 110 34 86 32 56 C30 36 12 30 16 14" stroke="#8a5a34" stroke-width="4.5" stroke-linecap="round" opacity="0.35" />
        </g>

        <g class="cat-leg cat-leg--hind-far">
          <path d="M126 120 C120 134 116 146 118 156" stroke="#5a3a22" stroke-width="8" stroke-linecap="round" />
          <ellipse cx="116" cy="157" rx="9" ry="4.4" fill="#24150c" />
        </g>

        <g class="cat-body" filter="url(#maat-soft)">
          <path
            d="M90 124 C84 96 104 70 140 66 C172 62 190 78 198 98 C204 114 198 128 184 136 C166 148 138 152 114 146 C96 142 92 134 90 124 Z"
            fill="url(#maat-ivory)"
          />
          <path d="M114 130 C128 140 162 140 178 122 C172 136 148 146 124 142 C114 140 110 134 114 130 Z" fill="#fff6e4" opacity="0.62" />
          <ellipse cx="174" cy="104" rx="22" ry="18" fill="#6b4328" opacity="0.16" />
          <path d="M102 94 C124 78 156 76 184 92" stroke="#f3e2c2" stroke-width="2.2" opacity="0.4" />
          <path d="M108 102 C128 90 156 90 180 102" stroke="#c9a36f" stroke-width="1" opacity="0.3" />
        </g>

        <g class="cat-leg cat-leg--hind-near">
          <path d="M150 122 C148 138 154 148 160 157" stroke="url(#maat-point-leg)" stroke-width="9" stroke-linecap="round" />
          <ellipse cx="162" cy="158" rx="10" ry="4.6" fill="#24150c" />
        </g>
        <g class="cat-leg cat-leg--fore-far">
          <path d="M168 116 C174 132 176 144 172 156" stroke="#5a3a22" stroke-width="7.4" stroke-linecap="round" />
          <ellipse cx="170" cy="157" rx="8.4" ry="4.1" fill="#24150c" />
        </g>
        <g class="cat-leg cat-leg--fore-near">
          <path d="M184 114 C186 132 180 146 176 157" stroke="url(#maat-point-leg)" stroke-width="8.6" stroke-linecap="round" />
          <ellipse cx="174" cy="158" rx="10" ry="4.5" fill="#24150c" />
        </g>

        <g class="cat-head">
          <path d="M176 98 C182 88 190 84 198 88 C190 104 182 110 174 110 Z" fill="url(#maat-ivory)" />
          <path d="M198 60 L206 34 L216 62 Z" fill="#3a2414" />
          <path
            d="M186 94 C188 66 206 50 224 54 C238 58 246 70 244 84 C242 98 228 106 212 104 C196 102 186 100 186 94 Z"
            fill="url(#maat-ivory)"
          />
          <path class="cat-ear cat-ear--near" d="M206 62 L216 26 L230 64 Z" fill="url(#maat-seal)" />
          <path d="M212 60 L218 36 L226 62 Z" fill="#c99290" />
          <path d="M200 56 C210 44 230 44 240 58 C246 68 246 82 238 90 C226 78 210 70 200 68 Z" fill="url(#maat-mask)" opacity="0.94" />
          <ellipse cx="234" cy="90" rx="14" ry="10" fill="#fff3dc" />
          <g class="cat-eye-open">
            <ellipse cx="224" cy="70" rx="10" ry="8" fill="#1a120c" />
            <ellipse cx="224" cy="70" rx="8.4" ry="6.6" fill="url(#maat-eye)" filter="url(#maat-eye-glow)" />
            <ellipse class="cat-pupil" cx="224.6" cy="70.2" rx="1.8" ry="5.2" fill="#070b10" />
            <circle cx="227" cy="67.2" r="1.4" fill="#f4fbff" />
          </g>
          <g class="cat-lids cat-lids--sleepy">
            <path d="M214 62 C220 68 230 68 234 64 C230 60 218 58 214 62 Z" fill="#3a2414" />
          </g>
          <g class="cat-lids cat-lids--happy">
            <path d="M214 74 C220 68 230 68 234 74" stroke="#1a120c" stroke-width="2.2" stroke-linecap="round" />
          </g>
          <path class="cat-eye-shut" d="M214 72 C220 78 230 78 234 72" stroke="#2a160c" stroke-width="2.2" stroke-linecap="round" />
          <ellipse cx="240" cy="86" rx="3.2" ry="2.2" fill="#b56b6e" />
          <path class="cat-mouth-shut" d="M240 89 C237 94 232 94 228 90" stroke="#6d4038" stroke-width="1.3" stroke-linecap="round" />
          <ellipse class="cat-mouth-eat" cx="238" cy="93" rx="5" ry="3.4" fill="#6b3034" />
          <path d="M220 92 H196" stroke="#f0dfc4" stroke-width="1.1" opacity="0.75" />
          <path d="M220 97 H192" stroke="#f0dfc4" stroke-width="0.95" opacity="0.45" />
          <path d="M236 96 H254" stroke="#f0dfc4" stroke-width="1" opacity="0.5" />
        </g>
      </g>

      <!-- Sit / loaf / groom / watch -->
      <g class="cat-pose cat-pose--sit">
