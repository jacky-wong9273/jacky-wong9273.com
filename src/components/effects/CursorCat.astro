          <ellipse cx="176" cy="126" rx="22" ry="18" fill="#5c3d26" opacity="0.18" />
        </g>
        <ellipse class="cat-paw" cx="108" cy="153" rx="14" ry="6.6" fill="#24150c" />
        <ellipse class="cat-paw" cx="136" cy="154" rx="13" ry="6.2" fill="#24150c" />
        <g class="cat-groom-arm">
          <path d="M88 120 C70 104 68 82 86 70" stroke="#e6d0a6" stroke-width="9" stroke-linecap="round" />
          <ellipse cx="88" cy="68" rx="7" ry="5.6" fill="#24150c" />
        </g>
        <g class="cat-head">
          <path class="cat-ear cat-ear--l" d="M86 58 L76 16 L112 48 Z" fill="url(#maat-seal)" />
          <path d="M90 54 L84 26 L108 48 Z" fill="#c99290" />
          <path class="cat-ear cat-ear--r" d="M150 54 L168 14 L134 46 Z" fill="url(#maat-seal)" />
          <path d="M148 52 L160 24 L136 46 Z" fill="#c99290" />
          <path
            d="M88 64 C86 40 102 26 122 24 C144 22 160 38 158 62 C156 82 140 92 122 92 C100 92 90 80 88 64 Z"
