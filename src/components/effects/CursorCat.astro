          />
          <path d="M94 48 C104 30 144 28 154 48 C158 60 150 72 138 76 C128 64 114 64 104 76 C94 68 90 58 94 48 Z" fill="url(#maat-mask)" />
          <ellipse cx="122" cy="78" rx="16" ry="11.5" fill="#fff4e0" />
          <g class="cat-eye-open">
            <path d="M102 56 C106 50.5 116 50 120 56 C116 61 107 61.5 102 56 Z" fill="#122334" />
            <path d="M104 56 C107 52.4 114 52 117.5 56 C114 59.2 107.5 59.6 104 56 Z" fill="url(#maat-eye)" />
            <ellipse class="cat-pupil" cx="110.6" cy="55.8" rx="1.5" ry="3.4" fill="#070b10" />
            <circle cx="112" cy="54.2" r="0.85" fill="#eef8ff" />
            <path d="M130 54 C134 48.8 144 48.4 148 54.4 C144 59.4 135 60 130 54 Z" fill="#122334" />
            <path d="M132 54 C135 50.8 142 50.4 145.4 54.4 C142 57.6 135.6 58 132 54 Z" fill="url(#maat-eye)" />
            <ellipse class="cat-pupil" cx="138.6" cy="53.8" rx="1.5" ry="3.4" fill="#070b10" />
            <circle cx="140" cy="52.2" r="0.85" fill="#eef8ff" />
          </g>
          <g class="cat-eye-shut">
            <path d="M102 57 C108 61 118 61 120 57" stroke="#3a2414" stroke-width="1.8" stroke-linecap="round" />
            <path d="M130 55 C136 59 146 59 148 55" stroke="#3a2414" stroke-width="1.8" stroke-linecap="round" />
          </g>
          <ellipse cx="122" cy="76" rx="3" ry="2.1" fill="#a86a6c" />
          <path class="cat-mouth-shut" d="M122 79 C118 84 112 83 110 80" stroke="#6d4038" stroke-width="1.15" stroke-linecap="round" />
          <path class="cat-mouth-shut" d="M122 79 C126 84 132 83 134 80" stroke="#6d4038" stroke-width="1.15" stroke-linecap="round" />
          <ellipse class="cat-mouth-eat" cx="122" cy="84" rx="5" ry="3.4" fill="#6b3034" />
          <path d="M104 80 H82" stroke="#e8d5b8" stroke-width="1" opacity="0.7" />
          <path d="M104 84 H78" stroke="#e8d5b8" stroke-width="0.85" opacity="0.4" />
          <path d="M140 80 H162" stroke="#e8d5b8" stroke-width="1" opacity="0.7" />
          <path d="M140 84 H166" stroke="#e8d5b8" stroke-width="0.85" opacity="0.4" />
        </g>
      </g>

      <!-- Curled sleep -->
      <g class="cat-pose cat-pose--sleep">
        <ellipse class="cat-ground" cx="132" cy="160" rx="58" ry="6" fill="#140c08" opacity="0.28" />
        <g class="cat-tail">
          <path d="M150 118 C186 108 204 84 190 60 C176 40 148 70 146 96" stroke="url(#maat-tail)" stroke-width="12" stroke-linecap="round" />
        </g>
        <g class="cat-body" filter="url(#maat-soft)">
          <path
            d="M86 128 C78 96 100 70 138 68 C176 66 204 92 198 124 C194 150 160 158 128 154 C100 150 90 142 86 128 Z"
            fill="url(#maat-ivory)"
            filter="url(#maat-fur)"
          />
          <ellipse cx="140" cy="118" rx="34" ry="22" fill="#fff6e4" opacity="0.45" />
        </g>
        <g class="cat-head">
          <path class="cat-ear cat-ear--l" d="M108 86 L98 56 L124 80 Z" fill="url(#maat-seal)" />
          <path class="cat-ear cat-ear--r" d="M148 82 L164 54 L136 78 Z" fill="url(#maat-seal)" />
          <ellipse cx="132" cy="100" rx="28" ry="22" fill="url(#maat-ivory-sit)" />
          <path d="M110 90 C118 76 148 74 156 90 C158 100 148 108 132 108 C116 108 108 100 110 90 Z" fill="url(#maat-mask)" opacity="0.88" />
          <g class="cat-eye-shut">
            <path d="M116 98 C122 102 128 102 132 98" stroke="#3a2414" stroke-width="1.8" stroke-linecap="round" />
            <path d="M136 97 C142 101 148 101 152 97" stroke="#3a2414" stroke-width="1.8" stroke-linecap="round" />
          </g>
          <ellipse cx="132" cy="106" rx="2.4" ry="1.7" fill="#a86a6c" />
          <path d="M118 108 C124 114 140 114 146 108" stroke="#6d4038" stroke-width="1.1" stroke-linecap="round" />
        </g>
      </g>

      <!-- Morning stretch -->
      <g class="cat-pose cat-pose--stretch">
        <ellipse class="cat-ground" cx="128" cy="161" rx="86" ry="6" fill="#140c08" opacity="0.26" />
        <g class="cat-tail">
          <path d="M196 96 C222 80 236 52 228 28" stroke="url(#maat-tail)" stroke-width="10" stroke-linecap="round" />
        </g>
        <g class="cat-leg cat-leg--hind-far">
          <path d="M176 118 C184 134 190 146 188 156" stroke="#5a3a22" stroke-width="8" stroke-linecap="round" />
          <ellipse cx="186" cy="157" rx="9" ry="4.2" fill="#24150c" />
        </g>
        <g class="cat-body" filter="url(#maat-soft)">
          <path
            d="M58 128 C70 110 110 92 150 86 C176 82 194 90 200 108 C206 124 196 136 176 140 C140 148 96 150 70 144 C56 140 52 134 58 128 Z"
            fill="url(#maat-ivory)"
          />
          <path d="M80 136 C110 144 150 140 176 128" stroke="#fff6e4" stroke-width="6" opacity="0.35" />
        </g>
        <g class="cat-leg cat-leg--hind-near">
          <path d="M168 122 C166 138 170 148 176 157" stroke="url(#maat-point-leg)" stroke-width="9" stroke-linecap="round" />
          <ellipse cx="178" cy="158" rx="10" ry="4.4" fill="#24150c" />
        </g>
        <g class="cat-leg cat-leg--fore-near">
          <path d="M70 128 C54 138 40 148 34 156" stroke="url(#maat-point-leg)" stroke-width="8" stroke-linecap="round" />
          <ellipse cx="32" cy="157" rx="11" ry="4.6" fill="#24150c" />
        </g>
        <g class="cat-leg cat-leg--fore-far">
          <path d="M80 130 C68 140 58 150 54 156" stroke="#5a3a22" stroke-width="7" stroke-linecap="round" />
          <ellipse cx="52" cy="157" rx="9" ry="4.2" fill="#24150c" />
        </g>
        <g class="cat-head">
          <path class="cat-ear cat-ear--l" d="M60 118 L50 90 L74 114 Z" fill="url(#maat-seal)" />
          <path class="cat-ear cat-ear--r" d="M86 114 L102 88 L78 112 Z" fill="url(#maat-seal)" />
          <ellipse cx="72" cy="124" rx="22" ry="16" fill="url(#maat-ivory-sit)" />
          <path d="M56 118 C64 108 86 106 92 118 C90 126 80 130 72 130 C62 130 54 124 56 118 Z" fill="url(#maat-mask)" opacity="0.9" />
          <g class="cat-eye-open">
            <path d="M60 122 C64 119 70 119 74 122" stroke="#2f7fbf" stroke-width="2.2" stroke-linecap="round" />
            <path d="M78 121 C82 118 88 118 92 121" stroke="#2f7fbf" stroke-width="2.2" stroke-linecap="round" />
          </g>
          <ellipse cx="70" cy="128" rx="2.1" ry="1.5" fill="#a86a6c" />
        </g>
      </g>
    </svg>
  </div>
</div>

