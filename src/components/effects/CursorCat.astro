          <ellipse cx="86" cy="70" rx="8" ry="6" fill="#1c1008" />
        </g>
        <g class="cat-head">
          <path class="cat-ear cat-ear--l" d="M78 62 L66 8 L118 50 Z" fill="url(#maat-seal)" />
          <path d="M84 56 L76 20 L110 48 Z" fill="#d7a39c" />
          <path d="M88 52 L84 28 L104 48" stroke="#8a5a34" stroke-width="1" opacity="0.35" />
          <path class="cat-ear cat-ear--r" d="M178 58 L200 6 L140 48 Z" fill="url(#maat-seal)" />
          <path d="M174 54 L190 18 L146 48 Z" fill="#d7a39c" />
          <path
