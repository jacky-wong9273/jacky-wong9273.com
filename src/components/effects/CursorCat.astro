---
import CatContextMenu from './CatContextMenu.astro';
---

<div class="cursor-cat" id="cursor-cat" aria-hidden="true" data-pose="sit" data-expr="neutral" data-lure="toy">
  <div class="cursor-cat-trail" id="cursor-cat-trail"></div>

  <div class="cursor-cat-wrap">
    <div class="cat-zzz">
      <span>z</span>
      <span>z</span>
      <span>Z</span>
    </div>

    <div class="cursor-cat-sprite">
      <img class="cat-pose cat-pose--side" src="/cat/wichien-side.webp" alt="" width="720" height="525" decoding="async" />
      <img class="cat-pose cat-pose--sit" src="/cat/wichien-sit.webp" alt="" width="720" height="629" decoding="async" />
      <img class="cat-pose cat-pose--sleep" src="/cat/wichien-sleep.webp" alt="" width="720" height="444" decoding="async" />
      <img class="cat-pose cat-pose--stretch" src="/cat/wichien-stretch.webp" alt="" width="720" height="299" decoding="async" />
      <img class="cat-pose cat-pose--pounce" src="/cat/wichien-pounce.webp" alt="" width="720" height="383" decoding="async" />
    </div>
  </div>
</div>

<div class="cat-lure" id="cat-lure" data-lure="toy" aria-hidden="true">
  <img class="lure-art lure-art--toy" src="/cat/lure-bird.webp" alt="" width="256" height="216" decoding="async" />
  <img class="lure-art lure-art--food" src="/cat/lure-fur.webp" alt="" width="256" height="263" decoding="async" />
</div>

<div class="cat-jam-catcher" id="cat-jam-catcher" aria-hidden="true"></div>

<CatContextMenu />

<style>
  .cursor-cat {
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .cursor-cat.is-on {
    opacity: 1;
  }

  .cursor-cat-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 260px;
    height: 180px;
    will-change: transform;
    transform-origin: 50% 70%;
  }

  .cursor-cat-sprite {
    position: relative;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 10px 12px rgba(20, 12, 8, 0.38));
    transform-origin: 50% 85%;
  }

  .cat-pose {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    user-select: none;
  }

  .cursor-cat[data-pose='side'] .cat-pose--side,
  .cursor-cat[data-pose='sit'] .cat-pose--sit,
  .cursor-cat[data-pose='sleep'] .cat-pose--sleep,
  .cursor-cat[data-pose='stretch'] .cat-pose--stretch,
  .cursor-cat[data-pose='pounce'] .cat-pose--pounce {
    opacity: 1;
    visibility: visible;
  }

  .cat-zzz {
    position: absolute;
    top: 4px;
    right: 28px;
    display: flex;
    gap: 2px;
    opacity: 0;
    font-family: var(--font-display);
    font-weight: 700;
    color: #fde68a;
    text-shadow: 0 0 8px rgba(251, 191, 36, 0.45);
  }

  .cat-zzz span {
    animation: maat-zzz 2.6s ease-in-out infinite;
  }

  .cat-zzz span:nth-child(2) {
    animation-delay: 0.28s;
    font-size: 0.85em;
  }

  .cat-zzz span:nth-child(3) {
    animation-delay: 0.55s;
    font-size: 1.15em;
  }

  .cursor-cat.is-sleep .cat-zzz {
    opacity: 1;
  }

  .cursor-cat.is-loaf .cursor-cat-wrap,
  .cursor-cat.is-sleep .cursor-cat-wrap,
  .cursor-cat.is-groom .cursor-cat-wrap {
    animation: maat-breathe 4.2s ease-in-out infinite;
  }

  .cursor-cat.is-groom .cursor-cat-sprite {
    animation: maat-groom-photo 1.8s ease-in-out infinite;
  }

  .cursor-cat.is-moving .cursor-cat-sprite {
    animation: maat-chase-run var(--gait, 0.7s) ease-in-out infinite;
  }

  .cursor-cat.is-pouncing .cursor-cat-sprite {
    transform: scaleX(1.06) scaleY(0.9);
    animation: none;
  }

  .cursor-cat.is-jamming .cursor-cat-sprite {
    animation: maat-jam-shake 0.22s ease-in-out infinite;
  }

  .cursor-cat.is-fleeing .cursor-cat-sprite {
    animation: maat-chase-run 0.3s ease-in-out infinite;
  }

  .cursor-cat.is-excited .cursor-cat-sprite {
    filter: drop-shadow(0 10px 12px rgba(20, 12, 8, 0.38)) saturate(1.12);
  }

  .cat-lure {
    position: fixed;
    top: 0;
    left: 0;
    width: 68px;
    height: 58px;
    margin: -22px 0 0 -18px;
    will-change: transform;
    z-index: 130;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.5)) drop-shadow(0 0 8px rgba(251, 191, 36, 0.22));
  }

  .cat-lure.is-visible {
    opacity: 1;
  }

  .cat-lure[hidden] {
    display: none;
  }

  .lure-art {
    position: absolute;
    inset: 0;
    width: 68px;
    height: 58px;
    object-fit: contain;
    object-position: center;
    overflow: visible;
    opacity: 0;
    pointer-events: none;
    user-select: none;
  }

  .cat-lure[data-lure='toy'] .lure-art--toy,
  .cat-lure[data-lure='food'] .lure-art--food {
    opacity: 1;
  }

  .cat-lure.is-running[data-lure='toy'] .lure-art--toy {
    animation: lure-bird-flap 0.28s ease-in-out infinite;
  }

  .cat-lure.is-running[data-lure='food'] .lure-art--food {
    animation: lure-fur-bounce 0.42s ease-in-out infinite;
  }

  .cat-lure.is-batted .lure-art {
    animation: lure-bonk 0.32s ease-out;
  }

  .cat-lure.is-jammed[data-lure='toy'] .lure-art--toy {
    animation: lure-struggle 0.22s ease-in-out infinite;
  }

  .cat-lure.is-jammed[data-lure='food'] .lure-art--food {
    animation: lure-fur-squish 0.26s ease-in-out infinite;
  }

  .cat-jam-catcher {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
  }

  html.is-cat-jamming .cat-jam-catcher {
    pointer-events: auto;
    cursor: none;
  }

  .cursor-cat-trail {
    position: absolute;
    inset: 0;
  }

  @media (max-width: 768px) {
    .cursor-cat-wrap {
      width: 210px;
      height: 146px;
    }

    .cat-lure,
    .lure-art {
      width: 56px;
      height: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-cat-wrap,
    .cursor-cat-sprite,
    .lure-art {
      animation: none !important;
    }
  }
</style>

<script>
  import { initWichienMaat } from '../../scripts/wichien-maat';

  initWichienMaat();
</script>
