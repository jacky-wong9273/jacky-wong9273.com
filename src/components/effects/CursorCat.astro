          <path d="M188 132 C210 122 220 98 210 78" stroke="#8a5a34" stroke-width="3" opacity="0.35" />
        </g>
        <g class="cat-body" filter="url(#maat-soft)">
          <ellipse cx="168" cy="138" rx="32" ry="26" fill="#d7b483" />
          <path d="M78 148 C74 116 96 102 132 100 C170 98 196 116 198 144 C200 164 172 172 130 174 C90 176 80 162 78 148 Z" fill="url(#maat-ivory-sit)" />
          <ellipse cx="128" cy="148" rx="38" ry="16" fill="#fff6e6" opacity="0.55" />
          <ellipse cx="170" cy="140" rx="20" ry="16" fill="#5c3d26" opacity="0.2" />
          <path d="M92 118 C110 108 140 106 168 116" stroke="#f4e4c4" stroke-width="2.2" opacity="0.45" />
          <path d="M100 124 C118 116 148 116 170 124" stroke="#c9a36f" stroke-width="1" opacity="0.35" />
        </g>
        <path d="M100 150 C98 162 102 170 110 172" stroke="url(#maat-point-leg)" stroke-width="11" stroke-linecap="round" />
        <path d="M132 152 C132 164 136 170 144 172" stroke="url(#maat-point-leg)" stroke-width="11" stroke-linecap="round" />
        <ellipse class="cat-paw" cx="110" cy="172" rx="13" ry="6" fill="#1c1008" />
        <ellipse class="cat-paw" cx="144" cy="172" rx="12" ry="5.6" fill="#1c1008" />
        <g class="cat-groom-arm">
