<CatContextMenu />

<style>
  .cursor-cat {
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .cursor-cat.is-on {
    opacity: 1;
  }

  .cursor-cat-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 200px;
    height: 140px;
    will-change: transform;
    transform-origin: 50% 70%;
  }

  .cursor-cat-svg {
    width: 200px;
    height: 140px;
    overflow: visible;
    filter: drop-shadow(0 10px 12px rgba(20, 12, 8, 0.32));
  }

  .cat-pose {
    opacity: 0;
    visibility: hidden;
  }

  .cursor-cat[data-pose='side'] .cat-pose--side,
  .cursor-cat[data-pose='sit'] .cat-pose--sit,
  .cursor-cat[data-pose='sleep'] .cat-pose--sleep,
  .cursor-cat[data-pose='stretch'] .cat-pose--stretch {
    opacity: 1;
    visibility: visible;
  }

  .cat-zzz {
    position: absolute;
    top: 4px;
    right: 28px;
    display: flex;
    gap: 2px;
    opacity: 0;
    font-family: var(--font-display);
    font-weight: 700;
    color: #fde68a;
    text-shadow: 0 0 8px rgba(251, 191, 36, 0.45);
  }

  .cat-zzz span {
    animation: maat-zzz 2.6s ease-in-out infinite;
  }

  .cat-zzz span:nth-child(2) {
    animation-delay: 0.28s;
    font-size: 0.85em;
  }

  .cat-zzz span:nth-child(3) {
    animation-delay: 0.55s;
    font-size: 1.15em;
  }

  .cat-tail {
    transform-box: fill-box;
    transform-origin: left center;
    animation: maat-tail-slow 3.4s ease-in-out infinite;
  }

  .cat-pose--side .cat-tail {
    transform-origin: 90px 116px;
  }

  .cat-ear--l,
  .cat-ear--near,
  .cat-ear--r {
    transform-box: fill-box;
    transform-origin: bottom center;
    animation: maat-ear 6.4s ease-in-out infinite;
  }

  .cat-ear--r {
    animation-delay: 0.45s;
  }

  .cat-head {
    transform-box: fill-box;
    transform-origin: 70% 60%;
  }

  .cat-eye-shut,
  .cat-mouth-eat {
    opacity: 0;
  }

  .cat-groom-arm {
    opacity: 0;
  }

  .cursor-cat[data-expr='shut'] .cat-eye-open,
  .cursor-cat.is-yawning .cat-pose--sit .cat-eye-open {
    opacity: 0;
  }

  .cursor-cat[data-expr='shut'] .cat-eye-shut,
  .cursor-cat.is-yawning .cat-pose--sit .cat-eye-shut {
    opacity: 1;
  }

  .cursor-cat[data-expr='eat'] .cat-mouth-shut {
    opacity: 0;
  }

  .cursor-cat[data-expr='eat'] .cat-mouth-eat {
    opacity: 1;
  }

  .cursor-cat[data-expr='sleepy'] .cat-pupil,
  .cursor-cat[data-expr='neutral'] .cat-pupil {
    transform-box: fill-box;
    transform-origin: center;
    animation: maat-pupil-slit 8s ease-in-out infinite;
  }

  .cursor-cat[data-expr='focused'] .cat-pupil,
  .cursor-cat[data-expr='happy'] .cat-pupil,
