---
---

<div class="cursor-cat" id="cursor-cat" aria-hidden="true">
  <div class="cursor-cat-trail" id="cursor-cat-trail"></div>

  <div class="cursor-cat-wrap">
    <div class="cat-zzz" aria-hidden="true">
      <span>z</span>
      <span>z</span>
      <span>Z</span>
    </div>

    <svg class="cursor-cat-svg" viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="maat-ivory" x1="40" y1="78" x2="120" y2="154" gradientUnits="userSpaceOnUse">
          <stop stop-color="#fffdf8" />
          <stop offset="0.5" stop-color="#f6ead2" />
          <stop offset="1" stop-color="#e8d3b0" />
        </linearGradient>
        <linearGradient id="maat-seal" x1="110" y1="16" x2="146" y2="118" gradientUnits="userSpaceOnUse">
          <stop stop-color="#4a2c18" />
          <stop offset="0.55" stop-color="#26150c" />
          <stop offset="1" stop-color="#120806" />
        </linearGradient>
        <linearGradient id="maat-mask" x1="80" y1="16" x2="80" y2="94" gradientUnits="userSpaceOnUse">
          <stop stop-color="#4a2e1c" />
          <stop offset="0.62" stop-color="#2a180e" />
          <stop offset="0.88" stop-color="#3d2a18" />
          <stop offset="1" stop-color="#3d2a18" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="maat-sock" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f4e6cc" />
          <stop offset="0.38" stop-color="#a07850" />
          <stop offset="1" stop-color="#23150c" />
        </linearGradient>
        <linearGradient id="maat-eye" x1="0" y1="0" x2="0" y2="1">
          <stop stop-color="#62b8ee" />
          <stop offset="0.4" stop-color="#1574c4" />
          <stop offset="1" stop-color="#0a4a88" />
        </linearGradient>
        <filter id="maat-soft" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="4" stdDeviation="3" flood-color="#2a160c" flood-opacity="0.28" />
        </filter>
      </defs>

      <g class="cat-tail">
        <path
          d="M108 118 C130 128 150 112 148 86 C146 62 160 46 152 22 C150 14 140 16 142 26 C150 48 136 62 134 86 C132 106 118 116 108 112 Z"
          fill="url(#maat-seal)"
        />
      </g>

      <g class="cat-body" filter="url(#maat-soft)">
        <ellipse class="cat-haunch" cx="54" cy="124" rx="18" ry="16" fill="url(#maat-ivory)" />
        <path
          d="M80 70 C60 74 46 94 48 118 C50 140 64 152 80 154 C96 152 110 140 112 118 C114 94 100 74 80 70 Z"
          fill="url(#maat-ivory)"
        />
        <ellipse cx="80" cy="112" rx="16" ry="18" fill="#fffaf6" opacity="0.8" />
        <ellipse class="cat-hind-paw" cx="48" cy="144" rx="11" ry="7" fill="url(#maat-seal)" />
      </g>

      <g class="cat-legs">
        <g class="cat-paw cat-paw--l">
          <path
            d="M58 116 C56 116 54 120 54 126 V140 C54 148 60 152 66 152 C72 152 76 148 76 140 V126 C76 120 72 116 68 116 Z"
            fill="url(#maat-sock)"
          />
        </g>
        <g class="cat-paw cat-paw--r">
          <path
            d="M84 116 C82 116 80 120 80 126 V140 C80 148 86 152 92 152 C98 152 102 148 102 140 V126 C102 120 98 116 94 116 Z"
            fill="url(#maat-sock)"
          />
        </g>
        <g class="cat-groom-paw">
          <path
            d="M40 80 C35 84 34 92 37 100 L42 114 C45 120 54 118 54 110 L50 96 C48 86 45 78 40 80 Z"
            fill="url(#maat-sock)"
          />
        </g>
      </g>

      <g class="cat-head" filter="url(#maat-soft)">
        <ellipse cx="80" cy="82" rx="18" ry="10" fill="url(#maat-ivory)" />
        <path
          class="cat-mask"
          d="M80 20 C67 20 55 32 53 48 C51 64 62 82 80 92 C98 82 109 64 107 48 C105 32 93 20 80 20 Z"
          fill="url(#maat-mask)"
        />
        <path d="M70 80 Q80 90 90 80 Q80 86 70 80 Z" fill="#efe0c4" />
        <g class="cat-ear cat-ear--l">
          <path d="M56 42 L41 12 Q52 7 70 38 Z" fill="url(#maat-seal)" />
          <path d="M55 38 L48 20 L64 36 Z" fill="#d0899c" />
        </g>
        <g class="cat-ear cat-ear--r">
          <path d="M104 42 L119 12 Q108 7 90 38 Z" fill="url(#maat-seal)" />
          <path d="M105 38 L112 20 L96 36 Z" fill="#d0899c" />
        </g>

        <g class="cat-eyes cat-eyes--open">
          <ellipse class="cat-eye" cx="66" cy="50" rx="7.6" ry="8.2" fill="url(#maat-eye)" />
          <ellipse class="cat-eye" cx="94" cy="50" rx="7.6" ry="8.2" fill="url(#maat-eye)" />
          <ellipse cx="66" cy="50" rx="7.6" ry="8.2" fill="none" stroke="#7ec8f0" stroke-width="0.9" />
          <ellipse cx="94" cy="50" rx="7.6" ry="8.2" fill="none" stroke="#7ec8f0" stroke-width="0.9" />
          <ellipse cx="66" cy="51" rx="1.8" ry="3.8" fill="#071422" />
          <ellipse cx="94" cy="51" rx="1.8" ry="3.8" fill="#071422" />
          <circle cx="68.4" cy="47.2" r="1.7" fill="#f4fbff" />
          <circle cx="96.4" cy="47.2" r="1.7" fill="#f4fbff" />
          <path d="M59 46 Q66 43 73 46" stroke="#c5ebff" stroke-width="1.15" stroke-linecap="round" />
          <path d="M87 46 Q94 43 101 46" stroke="#c5ebff" stroke-width="1.15" stroke-linecap="round" />
        </g>
        <g class="cat-eyes cat-eyes--shut">
          <path d="M58 52 Q66 58 74 52" stroke="#140a06" stroke-width="2.5" stroke-linecap="round" />
          <path d="M86 52 Q94 58 102 52" stroke="#140a06" stroke-width="2.5" stroke-linecap="round" />
        </g>

        <ellipse cx="80" cy="70" rx="3" ry="2.1" fill="#6b3a40" />
        <path d="M80 72 V76" stroke="#4a242c" stroke-width="1.15" stroke-linecap="round" />
        <path class="cat-smile" d="M80 76 Q76 80 71 78" stroke="#3d2418" stroke-width="1.25" stroke-linecap="round" />
        <path class="cat-smile" d="M80 76 Q84 80 89 78" stroke="#3d2418" stroke-width="1.25" stroke-linecap="round" />

        <path d="M58 72 H36" stroke="#c4a078" stroke-width="1.1" opacity="0.7" />
        <path d="M59 76 H34" stroke="#c4a078" stroke-width="1.1" opacity="0.45" />
        <path d="M102 72 H124" stroke="#c4a078" stroke-width="1.1" opacity="0.7" />
        <path d="M101 76 H126" stroke="#c4a078" stroke-width="1.1" opacity="0.45" />
      </g>
    </svg>
  </div>
</div>

<div class="mouse-toy" id="mouse-toy" aria-hidden="true">
  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M30 30 C40 24 44 16 41 10" stroke="#e879a9" stroke-width="2.2" stroke-linecap="round" />
    <circle cx="40.5" cy="9.5" r="2" fill="#f9a8d4" />
    <ellipse cx="18" cy="26" rx="13" ry="10" fill="#d4d0dc" />
    <ellipse cx="20" cy="27" rx="8" ry="6" fill="#eeeaf3" />
    <circle cx="10" cy="18" r="5.2" fill="#c8c3d0" />
    <circle cx="18" cy="16" r="4.6" fill="#c8c3d0" />
    <circle cx="10" cy="18" r="2.6" fill="#f8b4cb" />
    <circle cx="18" cy="16" r="2.2" fill="#f8b4cb" />
    <circle cx="13" cy="25" r="1.15" fill="#2a160c" />
    <circle cx="19" cy="24.4" r="1.15" fill="#2a160c" />
    <circle cx="15.6" cy="28.2" r="1.5" fill="#f472b6" />
    <path d="M14 30 Q16 32 19 30" stroke="#7a4a2a" stroke-width="1.1" stroke-linecap="round" />
    <path d="M8 32 L6 36" stroke="#b8b2c0" stroke-width="1.4" stroke-linecap="round" />
    <path d="M14 34 L13 38" stroke="#b8b2c0" stroke-width="1.4" stroke-linecap="round" />
    <path d="M22 33 L23 37" stroke="#b8b2c0" stroke-width="1.4" stroke-linecap="round" />
  </svg>
</div>

<style>
  .cursor-cat {
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .cursor-cat.is-on {
    opacity: 1;
  }

  .cursor-cat-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 124px;
    height: 124px;
    will-change: transform;
    transform-origin: 50% 70%;
  }

  .cursor-cat-svg {
    width: 124px;
    height: 124px;
    overflow: visible;
    filter: drop-shadow(0 8px 14px rgba(42, 22, 12, 0.28));
  }

  .cat-zzz {
    position: absolute;
    top: 6px;
    right: 10px;
    display: flex;
    gap: 2px;
    opacity: 0;
    font-family: var(--font-display);
    font-weight: 700;
    color: #fde68a;
    text-shadow: 0 0 8px rgba(251, 191, 36, 0.45);
    pointer-events: none;
  }

  .cat-zzz span {
    animation: maat-zzz 2.2s ease-in-out infinite;
  }

  .cat-zzz span:nth-child(2) {
    animation-delay: 0.25s;
    font-size: 0.85em;
  }

  .cat-zzz span:nth-child(3) {
    animation-delay: 0.5s;
    font-size: 1.15em;
  }

  .cat-tail {
    transform-origin: 108px 114px;
    animation: maat-tail 2.4s ease-in-out infinite;
  }

  .cat-ear--l {
    transform-origin: 56px 40px;
    animation: maat-ear 5.2s ease-in-out infinite;
  }

  .cat-ear--r {
    transform-origin: 104px 40px;
    animation: maat-ear 5.2s ease-in-out 0.35s infinite;
  }

  .cat-eyes--open {
    transform-origin: 80px 50px;
    animation: maat-blink 5s ease-in-out infinite;
  }

  .cat-eyes--shut {
    opacity: 0;
  }

  .cat-groom-paw {
    opacity: 0;
    transform-origin: 44px 86px;
  }

  .cursor-cat-wrap {
    animation: maat-bob 2.8s ease-in-out infinite;
  }

  .cursor-cat.is-sleep .cursor-cat-wrap {
    animation: maat-sleep-breathe 3.4s ease-in-out infinite;
  }

  .cursor-cat.is-sleep .cat-eyes--open,
  .cursor-cat.is-groom .cat-eyes--open {
    opacity: 0;
    animation: none;
  }

  .cursor-cat.is-sleep .cat-eyes--shut,
  .cursor-cat.is-groom .cat-eyes--shut {
    opacity: 1;
  }

  .cursor-cat.is-sleep .cat-zzz {
    opacity: 1;
  }

  .cursor-cat.is-sleep .cat-tail {
    animation-duration: 3.6s;
  }

  .cursor-cat.is-sleep .cursor-cat-svg {
    transform: rotate(-10deg) translateY(6px);
  }

  .cursor-cat.is-play .cursor-cat-wrap {
    animation: maat-play-hop 0.7s ease-in-out infinite;
  }

  .cursor-cat.is-play .cat-paw--l,
  .cursor-cat.is-toy .cat-paw--l {
    transform-origin: 65px 120px;
    animation: maat-paw-bat 0.42s ease-in-out infinite;
  }

  .cursor-cat.is-chase .cursor-cat-wrap {
    animation: maat-chase-run 0.36s ease-in-out infinite;
  }

  .cursor-cat.is-chase .cat-body {
    transform-origin: 80px 130px;
    transform: scaleX(1.08) scaleY(0.94);
  }

  .cursor-cat.is-chase .cat-ear--l,
  .cursor-cat.is-chase .cat-ear--r {
    transform: rotate(-18deg);
    animation: none;
  }

  .cursor-cat.is-excited .cat-tail {
    animation-duration: 0.45s;
  }

  .cursor-cat.is-toy .cursor-cat-wrap {
    animation: maat-toy-wiggle 0.55s ease-in-out infinite;
  }

  .cursor-cat.is-groom .cat-groom-paw {
    opacity: 1;
    animation: maat-groom 1.4s ease-in-out infinite;
  }

  .cursor-cat.is-groom .cat-paw--l {
    opacity: 0;
  }

  .cursor-cat.is-groom .cat-head {
    transform-origin: 80px 52px;
    animation: maat-groom-head 1.4s ease-in-out infinite;
  }

  .cursor-cat.is-stretch .cat-body {
    transform-origin: 80px 148px;
    animation: maat-stretch 2.2s ease-in-out infinite;
  }

  .cursor-cat.is-stretch .cat-head {
    transform: translate(-6px, 6px);
  }

  .cursor-cat.is-stretch .cat-tail {
    animation-duration: 2.4s;
  }

  .cursor-cat.is-loaf .cat-paw--l,
  .cursor-cat.is-loaf .cat-paw--r,
  .cursor-cat.is-loaf .cat-hind-paw {
    transform: translateY(-8px) scaleY(0.55);
  }

  .cursor-cat.is-loaf .cat-body {
    transform: scaleY(0.92) translateY(6px);
  }

  .cursor-cat.is-loaf .cursor-cat-wrap {
    animation: maat-sleep-breathe 4s ease-in-out infinite;
  }

  .mouse-toy {
    position: fixed;
    top: 0;
    left: 0;
    width: 42px;
    height: 42px;
    margin: -10px 0 0 -8px;
    will-change: transform;
    z-index: 130;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.35));
  }

  .mouse-toy.is-visible {
    opacity: 1;
  }

  .mouse-toy[hidden] {
    display: none;
  }

  .mouse-toy svg {
    width: 42px;
    height: 42px;
    overflow: visible;
  }

  .mouse-toy.is-running svg {
    animation: mouse-toy-scurry 0.28s ease-in-out infinite;
  }

  .mouse-toy.is-batted svg {
    animation: mouse-toy-bonk 0.28s ease-out;
  }

  .cursor-cat-trail {
    position: absolute;
    inset: 0;
  }

  @media (max-width: 768px) {
    .cursor-cat-wrap,
    .cursor-cat-svg {
      width: 104px;
      height: 104px;
    }

    .mouse-toy,
    .mouse-toy svg {
      width: 34px;
      height: 34px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-cat-wrap,
    .cat-tail,
    .cat-ear--l,
    .cat-ear--r,
    .cat-eyes--open,
    .mouse-toy svg {
      animation: none !important;
    }
  }
</style>

<script>
  import { initWichienMaat } from '../../scripts/wichien-maat';

  initWichienMaat();
</script>
