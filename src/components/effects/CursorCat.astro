<CatContextMenu />

<style>
  .cursor-cat {
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .cursor-cat.is-on {
    opacity: 1;
  }

  .cursor-cat-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 248px;
    height: 172px;
    will-change: transform;
    transform-origin: 50% 70%;
  }

  .cursor-cat-svg {
    width: 248px;
    height: 172px;
    overflow: visible;
    filter: drop-shadow(0 10px 12px rgba(20, 12, 8, 0.32));
  }

  .cat-pose {
    opacity: 0;
    visibility: hidden;
  }

  .cursor-cat[data-pose='side'] .cat-pose--side,
  .cursor-cat[data-pose='sit'] .cat-pose--sit,
  .cursor-cat[data-pose='sleep'] .cat-pose--sleep,
  .cursor-cat[data-pose='stretch'] .cat-pose--stretch {
    opacity: 1;
    visibility: visible;
  }

  .cat-zzz {
    position: absolute;
    top: 4px;
    right: 28px;
    display: flex;
    gap: 2px;
    opacity: 0;
