---
import CatContextMenu from './CatContextMenu.astro';
---

<div
  class="cursor-cat"
  id="cursor-cat"
  aria-hidden="true"
  data-pose="sit"
  data-expr="neutral"
  data-lure="toy"
  data-mood="hunt"
  data-phase="none"
  data-frame="0"
>
  <div class="cursor-cat-trail" id="cursor-cat-trail"></div>

  <div class="cursor-cat-wrap">
    <div class="cat-zzz">
      <span>z</span>
      <span>z</span>
      <span>Z</span>
    </div>

    <div class="cursor-cat-sprite">
      <img class="cat-pose cat-pose--side" src="/cat/wichien-side.webp" alt="" width="720" height="525" decoding="async" />
      <img class="cat-pose cat-pose--sit" src="/cat/wichien-sit.webp" alt="" width="720" height="629" decoding="async" />
      <img class="cat-pose cat-pose--sleep" src="/cat/wichien-sleep.webp" alt="" width="720" height="444" decoding="async" />
      <img class="cat-pose cat-pose--stretch" src="/cat/wichien-stretch.webp" alt="" width="720" height="299" decoding="async" />
      <img class="cat-pose cat-pose--pounce" src="/cat/wichien-pounce.webp" alt="" width="720" height="383" decoding="async" />
      <img class="cat-pose cat-pose--leap" src="/cat/wichien-leap.webp" alt="" width="720" height="345" decoding="async" />
      <img class="cat-pose cat-pose--hold" src="/cat/wichien-hold.webp" alt="" width="720" height="353" decoding="async" />
      <img class="cat-pose cat-pose--bat" src="/cat/wichien-bat.webp" alt="" width="720" height="562" decoding="async" />
      <img class="cat-pose cat-pose--kick" src="/cat/wichien-kick.webp" alt="" width="720" height="382" decoding="async" />
      <img class="cat-pose cat-pose--walk cat-pose--walk-0" src="/cat/wichien-walk-0.webp" alt="" width="720" height="480" decoding="async" />
      <img class="cat-pose cat-pose--walk cat-pose--walk-1" src="/cat/wichien-walk-1.webp" alt="" width="720" height="480" decoding="async" />
      <img class="cat-pose cat-pose--walk cat-pose--walk-2" src="/cat/wichien-walk-2.webp" alt="" width="720" height="480" decoding="async" />
      <img class="cat-pose cat-pose--walk cat-pose--walk-3" src="/cat/wichien-walk-3.webp" alt="" width="720" height="480" decoding="async" />
    </div>
  </div>
</div>

<div class="cat-lure" id="cat-lure" data-lure="toy" data-flap="0" aria-hidden="true">
  <img class="lure-art lure-art--toy lure-art--flap-0" src="/cat/lure-bird.webp" alt="" width="256" height="216" decoding="async" />
  <img class="lure-art lure-art--toy lure-art--flap-1" src="/cat/lure-bird-up.webp" alt="" width="256" height="270" decoding="async" />
  <img class="lure-art lure-art--toy lure-art--flap-2" src="/cat/lure-bird-down.webp" alt="" width="256" height="149" decoding="async" />
  <img class="lure-art lure-art--food" src="/cat/lure-fur.webp" alt="" width="256" height="263" decoding="async" />
</div>

<div class="cat-jam-catcher" id="cat-jam-catcher" aria-hidden="true"></div>

<CatContextMenu />

<style>
  .cursor-cat {
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .cursor-cat.is-on {
    opacity: 1;
  }

  .cursor-cat-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 260px;
    height: 180px;
    will-change: transform;
    transform-origin: 50% 70%;
  }

  .cursor-cat-sprite {
    position: relative;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 10px 12px rgba(20, 12, 8, 0.38));
    transform-origin: 50% 85%;
  }

  .cat-pose {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    opacity: 0;
    pointer-events: none;
    user-select: none;
    transition: opacity 0.055s linear;
  }

  .cursor-cat[data-pose='side'] .cat-pose--side,
  .cursor-cat[data-pose='sit'] .cat-pose--sit,
  .cursor-cat[data-pose='sleep'] .cat-pose--sleep,
  .cursor-cat[data-pose='stretch'] .cat-pose--stretch,
  .cursor-cat[data-pose='pounce'] .cat-pose--pounce,
  .cursor-cat[data-pose='leap'] .cat-pose--leap,
  .cursor-cat[data-pose='hold'] .cat-pose--hold,
  .cursor-cat[data-pose='bat'] .cat-pose--bat,
  .cursor-cat[data-pose='kick'] .cat-pose--kick,
  .cursor-cat[data-pose='walk'][data-frame='0'] .cat-pose--walk-0,
  .cursor-cat[data-pose='walk'][data-frame='1'] .cat-pose--walk-1,
  .cursor-cat[data-pose='walk'][data-frame='2'] .cat-pose--walk-2,
  .cursor-cat[data-pose='walk'][data-frame='3'] .cat-pose--walk-3 {
    opacity: 1;
  }

  .cat-zzz {
    position: absolute;
    top: 4px;
    right: 28px;
    display: flex;
    gap: 2px;
    opacity: 0;
    font-family: var(--font-display);
    font-weight: 700;
    color: #fde68a;
    text-shadow: 0 0 8px rgba(251, 191, 36, 0.45);
  }

  .cat-zzz span {
    animation: maat-zzz 2.6s ease-in-out infinite;
  }

  .cat-zzz span:nth-child(2) {
    animation-delay: 0.28s;
    font-size: 0.85em;
  }

  .cat-zzz span:nth-child(3) {
    animation-delay: 0.55s;
    font-size: 1.15em;
  }

  .cursor-cat.is-sleep .cat-zzz {
    opacity: 1;
  }

  .cursor-cat.is-loaf .cursor-cat-wrap,
  .cursor-cat.is-sleep .cursor-cat-wrap,
  .cursor-cat.is-groom .cursor-cat-wrap {
    animation: maat-breathe 4.2s ease-in-out infinite;
  }

  .cursor-cat.is-groom .cursor-cat-sprite {
    animation: maat-groom-photo 1.8s ease-in-out infinite;
  }

  .cursor-cat[data-mood='hunt'].is-moving .cursor-cat-sprite {
    animation: maat-hunt-bob var(--gait, 0.55s) ease-in-out infinite;
  }

  .cursor-cat[data-mood='play'].is-moving .cursor-cat-sprite {
    animation: maat-play-hop var(--gait, 0.48s) ease-in-out infinite;
  }

  .cursor-cat[data-phase='pounce'] .cursor-cat-sprite {
    animation: none;
    transform: scaleX(1.05) scaleY(0.92);
  }

  .cursor-cat[data-phase='leap'] .cursor-cat-sprite {
    animation: maat-leap-stretch 0.28s ease-out;
  }

  .cursor-cat[data-phase='hold'] .cursor-cat-sprite {
    animation: maat-prey-hold 0.34s ease-in-out infinite;
  }

  .cursor-cat[data-phase='shake'] .cursor-cat-sprite {
    animation: maat-prey-shake 0.16s ease-in-out infinite;
  }

  .cursor-cat[data-phase='bat'] .cursor-cat-sprite {
    animation: maat-bat-swipe 0.34s ease-out;
  }

  .cursor-cat[data-phase='kick'] .cursor-cat-sprite {
    animation: maat-play-kick 0.22s ease-in-out infinite;
  }

  .cursor-cat[data-phase='flee'][data-mood='play'] .cursor-cat-sprite {
    animation: maat-play-hop 0.3s ease-in-out infinite;
  }

  .cursor-cat[data-phase='flee'][data-mood='hunt'] .cursor-cat-sprite {
    animation: maat-hunt-bob 0.28s ease-in-out infinite;
  }

  .cursor-cat.is-excited .cursor-cat-sprite {
    filter: drop-shadow(0 10px 12px rgba(20, 12, 8, 0.38)) saturate(1.12);
  }

  .cat-lure {
    position: fixed;
    top: 0;
    left: 0;
    width: 68px;
    height: 58px;
    margin: -22px 0 0 -18px;
    will-change: transform;
    z-index: 130;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.5)) drop-shadow(0 0 8px rgba(251, 191, 36, 0.22));
  }

  .cat-lure.is-visible {
    opacity: 1;
  }

  .cat-lure[hidden] {
    display: none;
  }

  .lure-art {
    position: absolute;
    inset: 0;
    width: 68px;
    height: 58px;
    object-fit: contain;
    object-position: center;
    overflow: visible;
    opacity: 0;
    pointer-events: none;
    user-select: none;
    transition: opacity 0.05s linear;
  }

  .cat-lure[data-lure='food'] .lure-art--food {
    opacity: 1;
  }

  .cat-lure[data-lure='toy'][data-flap='0'] .lure-art--flap-0,
  .cat-lure[data-lure='toy'][data-flap='1'] .lure-art--flap-1,
  .cat-lure[data-lure='toy'][data-flap='2'] .lure-art--flap-2 {
    opacity: 1;
  }

  .cat-lure.is-running[data-lure='toy'] .lure-art--toy {
    animation: lure-bird-hover 0.28s ease-in-out infinite;
  }

  .cat-lure.is-running[data-lure='food'] .lure-art--food {
    animation: lure-fur-bounce 0.42s ease-in-out infinite;
  }

  .cat-lure.is-batted[data-lure='food'] .lure-art--food {
    animation: lure-bonk 0.32s ease-out;
  }

  .cat-lure.is-tossed[data-lure='food'] .lure-art--food {
    animation: lure-fur-spin 0.55s ease-out;
  }

  .cat-lure.is-caught[data-lure='toy'] .lure-art--toy {
    animation: lure-struggle 0.14s ease-in-out infinite;
  }

  .cat-lure.is-caught[data-lure='food'] .lure-art--food {
    animation: lure-fur-squish 0.2s ease-in-out infinite;
  }

  .cat-jam-catcher {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
  }

  html.is-cat-jamming .cat-jam-catcher {
    pointer-events: auto;
    cursor: none;
  }

  .cursor-cat-trail {
    position: absolute;
    inset: 0;
  }

  @media (max-width: 768px) {
    .cursor-cat-wrap {
      width: 210px;
      height: 146px;
    }

    .cat-lure,
    .lure-art {
      width: 56px;
      height: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-cat-wrap,
    .cursor-cat-sprite,
    .lure-art,
    .cat-pose {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  import { initWichienMaat } from '../../scripts/wichien-maat';

  initWichienMaat();
</script>
