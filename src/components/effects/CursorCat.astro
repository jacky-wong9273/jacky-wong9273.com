          <path d="M88 50 C102 24 160 22 174 50 C180 66 168 84 150 90 C140 74 120 74 110 90 C94 82 84 66 88 50 Z" fill="url(#maat-mask)" />
          <ellipse cx="130" cy="92" rx="22" ry="16" fill="#fff3dc" />
          <ellipse cx="108" cy="58" rx="16" ry="12" fill="#c4a072" opacity="0.28" />
          <ellipse cx="152" cy="56" rx="16" ry="12" fill="#c4a072" opacity="0.28" />
          <g class="cat-eye-open">
            <ellipse cx="108" cy="60" rx="13" ry="10.5" fill="#1a120c" />
            <ellipse cx="108" cy="60" rx="11.2" ry="8.8" fill="url(#maat-eye)" filter="url(#maat-eye-glow)" />
            <ellipse class="cat-pupil" cx="108.4" cy="60.2" rx="2.4" ry="6.6" fill="#070b10" />
            <circle cx="111.4" cy="56.6" r="1.7" fill="#f4fbff" />
            <circle cx="105.2" cy="62.4" r="0.7" fill="#c9ecff" opacity="0.7" />
            <ellipse cx="152" cy="58" rx="13" ry="10.5" fill="#1a120c" />
            <ellipse cx="152" cy="58" rx="11.2" ry="8.8" fill="url(#maat-eye)" filter="url(#maat-eye-glow)" />
            <ellipse class="cat-pupil" cx="152.4" cy="58.2" rx="2.4" ry="6.6" fill="#070b10" />
            <circle cx="155.4" cy="54.6" r="1.7" fill="#f4fbff" />
            <circle cx="149.2" cy="60.4" r="0.7" fill="#c9ecff" opacity="0.7" />
          </g>
          <g class="cat-lids cat-lids--sleepy">
            <path d="M95 50 C104 58 114 58 121 52 C118 48 100 46 95 50 Z" fill="#3a2414" />
            <path d="M139 48 C148 56 158 56 165 50 C162 46 144 44 139 48 Z" fill="#3a2414" />
          </g>
          <g class="cat-lids cat-lids--happy">
            <path d="M96 64 C104 58 114 58 121 64" stroke="#1a120c" stroke-width="2.4" stroke-linecap="round" />
            <path d="M140 62 C148 56 158 56 165 62" stroke="#1a120c" stroke-width="2.4" stroke-linecap="round" />
          </g>
          <g class="cat-eye-shut">
            <path d="M96 62 C106 70 116 70 121 62" stroke="#2a160c" stroke-width="2.4" stroke-linecap="round" />
            <path d="M140 60 C150 68 160 68 165 60" stroke="#2a160c" stroke-width="2.4" stroke-linecap="round" />
          </g>
          <path d="M124 86 L130 92 L136 86" fill="#c17b7e" />
          <ellipse cx="130" cy="90" rx="4.2" ry="3" fill="#b56b6e" />
          <path d="M130 93 V98" stroke="#8a5552" stroke-width="1.2" />
          <path class="cat-mouth-shut" d="M130 98 C124 104 116 103 112 98" stroke="#6d4038" stroke-width="1.5" stroke-linecap="round" />
          <path class="cat-mouth-shut" d="M130 98 C136 104 144 103 148 98" stroke="#6d4038" stroke-width="1.5" stroke-linecap="round" />
          <ellipse class="cat-mouth-eat" cx="130" cy="102" rx="7" ry="4.6" fill="#6b3034" />
          <path d="M108 96 H78" stroke="#f0dfc4" stroke-width="1.15" opacity="0.8" />
          <path d="M108 101 H74" stroke="#f0dfc4" stroke-width="1" opacity="0.5" />
          <path d="M152 96 H182" stroke="#f0dfc4" stroke-width="1.15" opacity="0.8" />
          <path d="M152 101 H186" stroke="#f0dfc4" stroke-width="1" opacity="0.5" />
        </g>
      </g>

      <!-- Curled sleep -->
      <g class="cat-pose cat-pose--sleep">
        <ellipse class="cat-ground" cx="132" cy="160" rx="58" ry="6" fill="#140c08" opacity="0.28" />
        <g class="cat-tail">
          <path d="M150 118 C186 108 204 84 190 60 C176 40 148 70 146 96" stroke="url(#maat-tail)" stroke-width="12" stroke-linecap="round" />
